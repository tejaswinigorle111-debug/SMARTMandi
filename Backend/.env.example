# Government market data
# Create a key at https://data.gov.in/ and keep it private.
DATA_GOV_API_KEY=your_data_gov_api_key_here
# Copy the current resource UUID from the official data.gov.in dataset page.
DATA_GOV_RESOURCE_ID=
# Set this from the official resource metadata; supported values are INR/quintal or INR/kg.
DATA_GOV_PRICE_UNIT=

# Optional database health checks
DATABASE_URL=postgresql://username:password@host:5432/database

# Optional Supabase REST health check
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional server-side Google Maps Platform key.
# Enable only the APIs you use: Geocoding API and Routes API.
GOOGLE_MAPS_API_KEY=

# Required for net-realization comparisons. Set from your contracted/current cost schedules.
TRANSPORT_RATE_PER_KM_PER_KG=
STORAGE_COST_PER_KG=
PLATFORM_FEE_PERCENT=
OTHER_COST_PER_KG=
