# Government market data
# Create a key at https://data.gov.in/ and keep it private.
DATA_GOV_API_KEY=
# Current Daily Price of Various Commodities from Various Markets (Mandi)
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
# Supported values: INR/quintal or INR/kg.
DATA_GOV_PRICE_UNIT=INR/quintal
# Only markets within this straight-line radius are shown for a farmer location.
MAX_NEARBY_MARKET_DISTANCE_KM=100
# Drop mandi rows older than this many days (set blank to disable).
MAX_PRICE_AGE_DAYS=7

# Optional database health checks
DATABASE_URL=

# Optional Supabase REST health check
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional server-side Google Maps Platform key (Geocoding + Routes).
GOOGLE_MAPS_API_KEY=

# Required for the active recommendation calculation.
TRANSPORT_RATE_PER_KM_PER_KG=0.05
STORAGE_COST_PER_KG=0
PLATFORM_FEE_PERCENT=2
OTHER_COST_PER_KG=0
